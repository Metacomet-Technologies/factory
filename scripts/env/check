#!/usr/bin/env python3
"""Read-only check of the toolchain contract in docs/environments.md.

Usage: scripts/env/check --env <name> [--failing]

Prints one JSON object: the environment name, overall `ok`, and every contract
item with expected and actual values. Exits 1 when a required item fails, 2 on
usage errors. `--failing` prints only the failing required items instead, one
`name<TAB>expected<TAB>actual` line each (scripts/env/setup.sh and the sandbox
preflight read it). Items the environment is exempt from are reported with
`"required": false` and never fail the run.

Versions resolve the way builds do: `rustc` and `cargo` run in the repository
root (honoring rust-toolchain.toml), `node`, `bun` and `vp` resolve in `kiosk/`.
The check never installs or caches anything: rustup auto-install is forced off
and Vite+ shims are never executed (running one writes its resolve cache and
installs a missing pin). For a shim, `vp env current --json` names the
project's pinned versions and binaries; only real Node and Bun binaries run,
with `--version`, which writes no state. The Vite+ version comes from its
package manifest. The output never includes environment variables; command
output is cut to its first line.
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys

REPO = os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
KIOSK = os.path.join(REPO, "kiosk")

LAYOUT_CHECKOUT = "/home/agent/work/factory"
LAYOUT_VP_ENV = "/home/agent/.config/vite-plus/env"

# (contract item, command that proves it) for system packages; requirements, not install paths.
SYSTEM = [
    ("build-essential", "cc"),
    ("build-essential:make", "make"),
    ("pkg-config", "pkg-config"),
    ("curl", "curl"),
    ("python3", "python3"),
    ("util-linux", "flock"),
    ("bubblewrap", "bwrap"),
    ("shellcheck", "shellcheck"),
    ("sqlite3", "sqlite3"),
    ("zstd", "zstd"),
    ("rsync", "rsync"),
    ("xz-utils", "xz"),
]

EXEMPT = {
    "orb": {"playwright", "layout:checkout", "layout:vite-plus-env"},
    "sandbox": {"playwright", "layout:checkout", "layout:vite-plus-env"},
    # The hosted runner lacks bwrap; the sandbox job installs its own.
    "ci": {"playwright", "layout:checkout", "layout:vite-plus-env", "bubblewrap"},
    "factory-gpu": set(),
    "factory-console": set(),
}


def first_line(text):
    lines = text.strip().splitlines()
    return lines[0].strip()[:200] if lines else ""


def run(argv, cwd, whole=False):
    env = dict(os.environ, RUSTUP_AUTO_INSTALL="0")
    try:
        out = subprocess.run(
            argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return out.stdout if whole else first_line(out.stdout) or None


def version(text, pattern=r"(\d+\.\d+\.\d+)"):
    match = re.search(pattern, text or "")
    return match.group(1) if match else None


def read(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return None


def pins():
    toolchain = read(os.path.join(REPO, "rust-toolchain.toml")) or ""
    channel = re.search(r'^\s*channel\s*=\s*"([^"]+)"', toolchain, re.M)
    components = re.search(r"^\s*components\s*=\s*\[([^\]]*)\]", toolchain, re.M)
    package = json.loads(read(os.path.join(KIOSK, "package.json")) or "{}")
    engines = package.get("devEngines", {})
    manager = engines.get("packageManager", {})
    return {
        "rust": channel.group(1) if channel else None,
        "components": re.findall(r'"([^"]+)"', components.group(1)) if components else [],
        "node": engines.get("runtime", {}).get("version"),
        "node-root": (read(os.path.join(REPO, ".node-version")) or "").strip().lstrip("v") or None,
        "bun": manager.get("version") if manager.get("name") == "bun" else None,
        # The global `vp` matches the kiosk's own Vite+ pin.
        "vite-plus": package.get("catalog", {}).get("vite-plus"),
    }


def os_release(root):
    fields = {}
    for line in (read(os.path.join(root, "etc/os-release")) or "").splitlines():
        key, sep, value = line.partition("=")
        if sep:
            fields[key] = value.strip().strip('"')
    return fields


def package_version(binary, names):
    """Version in the nearest package.json above `binary` named one of `names`."""
    directory = os.path.dirname(os.path.realpath(binary))
    while directory != os.path.dirname(directory):
        try:
            manifest = json.loads(read(os.path.join(directory, "package.json")) or "{}")
        except ValueError:
            manifest = {}
        if manifest.get("name") in names:
            return manifest.get("version")
        directory = os.path.dirname(directory)
    return None


def js_tool(tool, cwd):
    """Return (version or None, detail) for node/bun as `cwd` resolves them, running only `--version`."""
    path = shutil.which(tool)
    if not path:
        return None, None
    real = os.path.realpath(path)
    if os.path.basename(real) != "vp":
        return run([path, "--version"], cwd), path
    # Vite+ shim: ask Vite+ for the project's resolution instead of running it.
    try:
        current = json.loads(run([real, "env", "current", "--json"], cwd, whole=True) or "")
    except ValueError:
        return None, "Vite+ could not resolve the environment"
    entry = current.get("node" if tool == "node" else "package_manager") or {}
    if tool != "node" and entry.get("name") != tool:
        return None, f"Vite+ resolves no {tool} here"
    binary = entry.get("bin_path") if tool == "node" else (entry.get("bin_paths") or {}).get(tool)
    if not entry.get("installed") or not binary or not os.access(binary, os.X_OK):
        return None, f"Vite+ pins {entry.get('version')}, not installed"
    return run([binary, "--version"], cwd), binary


def playwright(root):
    """Return (location, installed chromium executables) where Playwright looks."""
    configured = os.environ.get("PLAYWRIGHT_BROWSERS_PATH")
    if configured == "0":
        base = os.path.join(KIOSK, "node_modules", "playwright-core", ".local-browsers")
    elif configured:
        base = configured
    else:
        base = os.path.join(os.path.expanduser("~"), ".cache", "ms-playwright")
    found = []
    for directory in sorted(glob.glob(os.path.join(base, "chromium-*"))):
        if not os.path.isfile(os.path.join(directory, "INSTALLATION_COMPLETE")):
            continue
        for binary in glob.glob(os.path.join(directory, "chrome-linux*", "chrome")):
            if os.path.isfile(binary) and os.access(binary, os.X_OK):
                found.append(os.path.relpath(binary, base))
    return base, found


def items(root):
    pin = pins()
    result = []

    def add(name, expected, actual, ok):
        result.append({"name": name, "expected": expected, "actual": actual, "ok": bool(ok)})

    release = os_release(root)
    family = " ".join([release.get("ID", ""), release.get("ID_LIKE", "")]).split()
    arch = run(["uname", "-m"], REPO)
    add(
        "os",
        "ubuntu (or debian family) x86_64",
        f"{release.get('PRETTY_NAME', 'unknown')} {arch or 'unknown'}",
        ("ubuntu" in family or "debian" in family) and arch == "x86_64",
    )

    rustc = run(["rustc", "--version"], REPO)
    add("rust", pin["rust"], rustc, pin["rust"] and version(rustc) == pin["rust"])
    for component, argv in (("rustfmt", ["cargo", "fmt", "--version"]), ("clippy", ["cargo", "clippy", "--version"])):
        out = run(argv, REPO)
        add(f"rust:{component}", "installed", out, component in pin["components"] and out)

    for name, tool, cwd, expected in (
        ("node", "node", KIOSK, pin["node"]),
        ("node:repo-root", "node", REPO, pin["node-root"]),
        ("bun", "bun", KIOSK, pin["bun"]),
    ):
        out, detail = js_tool(tool, cwd)
        add(name, expected, f"{out} ({detail})" if out else detail, expected and version(out) == expected)
    vp = shutil.which("vp")
    # Global Vite+ installs are named vp-global; npm installs are vite-plus.
    found = package_version(vp, {"vite-plus", "vp-global"}) if vp else None
    expected = pin["vite-plus"]
    add("vite-plus", expected, f"{found} ({vp})" if found else vp, expected and found == expected)

    base, browsers = playwright(root)
    add(
        "playwright",
        "installed chromium-*/chrome-linux*/chrome",
        f"{base}: {', '.join(browsers) or 'none installed'}",
        browsers,
    )

    certs = os.path.join(root, "etc/ssl/certs/ca-certificates.crt")
    add("ca-certificates", certs, certs if os.path.isfile(certs) else None, os.path.isfile(certs))
    for name, command in SYSTEM:
        path = shutil.which(command)
        add(name, f"{command} on PATH", path, path)

    checkout = os.path.join(root, LAYOUT_CHECKOUT.lstrip("/"))
    is_checkout = os.path.isfile(os.path.join(checkout, "kiosk", "package.json"))
    add("layout:checkout", f"{LAYOUT_CHECKOUT} is a factory checkout", checkout if is_checkout else None, is_checkout)
    vp_env = os.path.join(root, LAYOUT_VP_ENV.lstrip("/"))
    add("layout:vite-plus-env", LAYOUT_VP_ENV, vp_env if os.path.isfile(vp_env) else None, os.path.isfile(vp_env))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--env", required=True, choices=sorted(EXEMPT))
    parser.add_argument("--failing", action="store_true", help="print failing required items as TSV, not JSON")
    # Tests point host paths (/etc, /home/agent) at a fixture tree.
    parser.add_argument("--root", default="/", help=argparse.SUPPRESS)
    args = parser.parse_args()

    exempt = EXEMPT[args.env]
    report = items(args.root)
    for item in report:
        item["required"] = item["name"] not in exempt
    ok = all(item["ok"] for item in report if item["required"])
    if args.failing:
        for item in report:
            if item["required"] and not item["ok"]:
                print("\t".join(str(item[key]) for key in ("name", "expected", "actual")))
        return 0 if ok else 1
    json.dump({"env": args.env, "ok": ok, "items": report}, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
