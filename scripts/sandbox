#!/usr/bin/env bash
set -euo pipefail
root=$(realpath "$(dirname "${BASH_SOURCE[0]}")/..")
state="$root/.sandbox"
helper="$root/scripts/sandbox-shims/runtime.py"
command=${1:-status}
if (($#)); then shift; fi
umask 077
[[ ! -L "$state" ]] || { echo 'Refusing symlinked .sandbox' >&2; exit 1; }
mkdir -p "$state"
# Lock the directory inode, so reset needs no persistent file outside .sandbox.
exec 9<"$state"
flock -n 9 || { echo 'Another sandbox command is running' >&2; exit 1; }

case "$command" in
    up|reset)
        rows=100000 seed=42 kiosk=0
        while (($#)); do
            case "$1" in
                --rows|--seed)
                    (($# >= 2)) || { echo "Missing value for $1" >&2; exit 1; }
                    if [[ "$1" == --rows ]]; then rows=$2; else seed=$2; fi
                    shift 2 ;;
                --kiosk) kiosk=1; shift ;;
                *) echo "Unknown argument: $1" >&2; exit 1 ;;
            esac
        done
        if [[ "$rows" =~ ^([0-9]+)[kK]$ ]]; then rows=$((10#${BASH_REMATCH[1]} * 1000)); fi
        [[ "$rows" =~ ^[0-9]{1,7}$ && "$seed" =~ ^[0-9]{1,18}$ ]] || { echo 'Invalid rows or seed' >&2; exit 1; }
        ((10#$rows >= 1 && 10#$rows <= 1000000)) || { echo 'Rows must be 1..1000000' >&2; exit 1; }
        # Contract preflight (docs/environments.md): name each unmet item before touching state.
        if ! failing=$("$root/scripts/env/check" --env sandbox --failing); then
            while IFS=$'\t' read -r name expected actual; do
                [[ -z "$name" ]] || echo "Toolchain contract item $name failed: expected $expected, found $actual" >&2
            done <<<"$failing"
            echo 'Sandbox not started. Run scripts/env/setup.sh --env sandbox, then retry.' >&2
            exit 1
        fi
        if [[ "$command" == reset ]]; then
            python3 "$helper" down "$root"
            # Preserve the locked directory inode; remove every entry inside it.
            find "$state" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
        fi
        python3 "$helper" preflight "$root" "$rows" "$seed"
        bwrap --unshare-net --ro-bind / / true
        cargo build --manifest-path "$root/Cargo.toml" --target-dir "$root/target" --release --locked -p sandbox -p meter -p factory-api -p factory-ups-control
        if ((kiosk)); then
            (cd "$root/kiosk"; vp install --frozen-lockfile; VITE_API_BASE='' vp build)
        fi
        # No inherited credentials, proxy settings, or application configuration at runtime.
        nohup env -i PATH=/usr/bin:/bin HOME="$state" \
            python3 "$helper" run "$root" "$rows" "$seed" "$kiosk" \
            >"$state/runtime.log" 2>&1 < /dev/null 9<&- &
        pid=$!
        trap 'python3 "$helper" down "$root"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        python3 "$helper" wait "$root" "$pid"
        trap - EXIT INT TERM
        ;;
    status|down)
        (($# == 0)) || { echo 'Unexpected arguments' >&2; exit 1; }
        python3 "$helper" "$command" "$root" ;;
    logs)
        [[ $# == 1 && "$1" =~ ^(fake-ollama|fake-upsd|fake-net|fake-serve|ups-control|meter|factory-api|seed|traffic|runtime)$ ]] || { echo 'Usage: scripts/sandbox logs <fake-ollama|fake-upsd|fake-net|fake-serve|ups-control|meter|factory-api|seed|traffic|runtime>' >&2; exit 1; }
        tail -n 100 "$state/$1.log" ;;
    *) echo 'Usage: scripts/sandbox {up [--rows 100k] [--seed 42] [--kiosk]|status|reset [up options]|down|logs <svc>}' >&2; exit 1 ;;
esac
