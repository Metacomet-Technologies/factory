[Unit]
Description=Linear factory work queue dispatcher
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
WorkingDirectory=/home/agent/work
Environment=HOME=/home/agent
Environment="PATH=@PATH@"
Environment="DISPATCH_RUNNERS=gpu=factory-gpu,console=factory-console"
Environment="DISPATCH_LEDGER=/home/agent/.local/state/factory-dispatch/dispatch.db"
# The Vite+ node shim takes Node from the promoted tools tree's .node-version, never its global
# default (MET-411); /home/agent/work carries no pin and stays the cwd the spawned CLIs expect.
ExecStart=/bin/sh -ec 'VP_NODE_VERSION=$$(cat /home/agent/factory-tools/current/.node-version); export VP_NODE_VERSION; exec @NODE@ /home/agent/factory-tools/current/scripts/dispatch/dispatch.ts poll'
NoNewPrivileges=true
TimeoutStartSec=1h
UMask=0077
StandardOutput=journal
StandardError=journal
