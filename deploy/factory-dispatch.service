[Unit]
Description=Linear factory work queue dispatcher
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
WorkingDirectory=/home/agent/work
Environment=HOME=/home/agent
Environment="PATH=@PATH@"
Environment="DISPATCH_RUNNERS=gpu=factory-gpu,console=factory-console"
Environment="DISPATCH_LEDGER=/home/agent/.local/state/factory-dispatch/dispatch.db"
ExecStart=@NODE@ /home/agent/factory-tools/current/scripts/dispatch/dispatch.ts poll
NoNewPrivileges=true
TimeoutStartSec=1h
UMask=0077
StandardOutput=journal
StandardError=journal
