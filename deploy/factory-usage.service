[Unit]
Description=Collect Amp, Claude and Codex usage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agent
SupplementaryGroups=factory-api
WorkingDirectory=/home/agent/work
Environment=HOME=/home/agent
Environment="PATH=@PATH@"
# The Vite+ node shim takes Node from the promoted tools tree's .node-version, never its global
# default (MET-411); /home/agent/work carries no pin and stays the cwd the spawned CLIs expect.
ExecStart=/bin/sh -ec 'VP_NODE_VERSION=$$(cat /home/agent/factory-tools/current/.node-version); export VP_NODE_VERSION; exec @NODE@ /home/agent/factory-tools/current/scripts/usage/collect.ts'
NoNewPrivileges=true
TimeoutStartSec=5min
UMask=0027
StandardOutput=journal
StandardError=journal
