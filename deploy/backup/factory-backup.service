[Unit]
Description=Verified SQLite snapshots and cross-host replicas
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=root
Environment=BACKUP_CONFIG=/etc/factory-backup/nodes.conf
# Name-only lookup in credstore: an absent optional credential is not fatal.
LoadCredential=factory-r2
ExecStart=/usr/local/lib/factory-backup/factory-backup.sh
UMask=0027
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
