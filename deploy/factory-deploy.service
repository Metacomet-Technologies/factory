[Unit]
Description=ODD Deployer: install published releases on factory-gpu
Documentation=file:///home/agent/work/factory/docs/odd/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
WorkingDirectory=/home/agent/work
Environment=HOME=/home/agent
Environment="PATH=@PATH@"
ExecStartPre=/usr/bin/mkdir -p /home/agent/.local/state/factory-odd
# The Vite+ node shim takes Node from the promoted tools tree's .node-version, never its global
# default (MET-411); /home/agent/work carries no pin and stays the cwd the spawned CLIs expect.
ExecStart=/usr/bin/flock -n /home/agent/.local/state/factory-odd/deploy.lock /bin/sh -ec 'VP_NODE_VERSION=$$(cat /home/agent/factory-tools/current/.node-version); export VP_NODE_VERSION; exec @NODE@ /home/agent/factory-tools/current/scripts/odd/deploy.ts'
# sudo through the allowlist needs new privileges.
NoNewPrivileges=false
Nice=10
TimeoutStartSec=30min
UMask=0077
StandardOutput=journal
StandardError=journal
