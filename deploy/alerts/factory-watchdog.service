[Unit]
Description=Factory watchdog: alert Slack when factory-gpu is unreachable (MET-150)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=factory-watchdog
StateDirectoryMode=0700
LoadCredential=slack-bot-token:/etc/factory-alerts/slack-token
Environment=FACTORY_WATCHDOG_STATE=/var/lib/factory-watchdog/state.json
ExecStart=/usr/bin/python3 -I /usr/local/lib/factory-alerts/factory-watchdog.py
TimeoutStartSec=50
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
