{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GpuPoint": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GpuSample"
          },
          {
            "properties": {
              "samples": {
                "description": "Hourly rollup only: measurements averaged into this point; `ts` is the\nUTC hour start. Absent for raw samples.",
                "format": "int64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ],
        "description": "A GPU history point: a raw sample, or an hourly mean when `samples` is set."
      },
      "GpuResponse": {
        "properties": {
          "gpus": {
            "items": {
              "$ref": "#/components/schemas/GpuSample"
            },
            "type": "array"
          },
          "ollama_ps": {}
        },
        "required": [
          "gpus",
          "ollama_ps"
        ],
        "type": "object"
      },
      "GpuSample": {
        "properties": {
          "index": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "memory_total_mib": {
            "format": "double",
            "type": "number"
          },
          "memory_used_mib": {
            "format": "double",
            "type": "number"
          },
          "power_w": {
            "format": "double",
            "type": "number"
          },
          "temperature_c": {
            "format": "double",
            "type": "number"
          },
          "ts": {
            "format": "int64",
            "type": "integer"
          },
          "utilization_percent": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "ts",
          "index",
          "memory_used_mib",
          "memory_total_mib",
          "utilization_percent",
          "temperature_c",
          "power_w"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "built_at_ms": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "git_dirty": {
            "type": "boolean"
          },
          "git_sha": {
            "type": "string"
          },
          "inputs_fingerprint": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "git_sha",
          "git_dirty",
          "built_at_ms",
          "inputs_fingerprint"
        ],
        "type": "object"
      },
      "Maintenance": {
        "description": "Last rollup job outcome. A failed or lagging job is unhealthy maintenance;\nthe next five-minute run resumes from the committed checkpoint.",
        "properties": {
          "checked_at_ms": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "retention": {
            "$ref": "#/components/schemas/Retention"
          },
          "status": {
            "description": "\"ok\", \"unhealthy\", or \"pending\" before the first rollup run.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "retention"
        ],
        "type": "object"
      },
      "MeterHealth": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Health"
          },
          {
            "$ref": "#/components/schemas/QueueStatus"
          },
          {
            "properties": {
              "maintenance": {
                "$ref": "#/components/schemas/Maintenance",
                "description": "Rollup job health; status stays \"ok\" so inference health is unchanged."
              }
            },
            "required": [
              "maintenance"
            ],
            "type": "object"
          }
        ]
      },
      "MeterQuery": {
        "properties": {
          "limit": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "range": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "MeterRequestsQuery": {
        "properties": {
          "after_id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "limit": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ModelStats": {
        "properties": {
          "avg_generation_tokens_per_second": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "avg_prompt_tokens_per_second": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "p50_total_latency_ms": {
            "format": "double",
            "type": "number"
          },
          "p95_total_latency_ms": {
            "format": "double",
            "type": "number"
          },
          "percentiles_approximate": {
            "description": "True when percentiles come from merged fixed-bucket histograms (ranges\nbeyond 30 days); otherwise they are exact nearest-rank raw values.",
            "type": "boolean"
          },
          "requests": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "requests",
          "input_tokens",
          "output_tokens",
          "p50_total_latency_ms",
          "p95_total_latency_ms"
        ],
        "type": "object"
      },
      "QueueStatus": {
        "properties": {
          "dropped_gpu_samples": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "dropped_requests": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "queue_depth": {
            "description": "Accepted writes still outstanding, including the executing write.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "dropped_requests",
          "dropped_gpu_samples",
          "queue_depth"
        ],
        "type": "object"
      },
      "RequestRecord": {
        "description": "Durations reported by Ollama are nanoseconds. Timestamps are Unix milliseconds.",
        "properties": {
          "actor_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_hostname": {
            "type": "string"
          },
          "client_ip": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "eval_count": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "eval_duration": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "latency_ms": {
            "format": "double",
            "type": "number"
          },
          "load_duration": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_eval_count": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "prompt_eval_duration": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "stream": {
            "type": "boolean"
          },
          "total_duration": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ts": {
            "format": "int64",
            "type": "integer"
          },
          "usage": {
            "description": "The unmodified OpenAI usage object, when provided by upstream."
          },
          "user_key": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "ts",
          "endpoint",
          "latency_ms",
          "status",
          "stream",
          "client_ip",
          "client_hostname"
        ],
        "type": "object"
      },
      "Retention": {
        "description": "Raw request retention (MET-206): the lowest-ID run of rows older than\n365 days, only inside the verified request rollup. Runs after each rollup run.",
        "properties": {
          "checked_at_ms": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "cutoff_ms": {
            "description": "Rows with `ts_ms` strictly below this were eligible in the last run.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "detail": {
            "description": "Skip reason, error, or a note that pruning continues next run.",
            "type": [
              "string",
              "null"
            ]
          },
          "oldest_retained_id": {
            "description": "Lowest request ID still stored after the last run; null when empty.\nIDs below it were removed by retention; IDs above it never are.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "pruned_at_ms": {
            "description": "Last run that was allowed to prune, and the rows it deleted.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "pruned_rows": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "pruned_rows_since_start": {
            "description": "Rows deleted by every run since this process started.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "skipped_since_ms": {
            "description": "Start of the current streak of skipped or failed runs.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "description": "\"pending\" before the first run; \"ok\"; \"skipped\" when a gate is unmet;\n\"failed\" when the job errored, leaving every row in place.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "pruned_rows",
          "pruned_rows_since_start"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "license": {
      "name": ""
    },
    "title": "meter",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/meter/gpu": {
      "get": {
        "operationId": "gpu",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GpuResponse"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          }
        },
        "tags": []
      }
    },
    "/meter/gpu/history": {
      "get": {
        "operationId": "history_doc",
        "parameters": [
          {
            "description": "24h (default), 7d, 30d, 365d. Raw samples are retained 7 days; longer ranges return hourly means (with samples) before that.",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GpuPoint"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          }
        },
        "tags": []
      }
    },
    "/meter/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterHealth"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          }
        },
        "tags": []
      }
    },
    "/meter/openapi.json": {
      "get": {
        "operationId": "openapi_doc",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document"
          }
        },
        "tags": []
      }
    },
    "/meter/requests": {
      "get": {
        "operationId": "requests_doc",
        "parameters": [
          {
            "description": "Without after_id: 1..10000, default 100. With after_id: 1..5000, default 500.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Nonnegative cursor: return id > after_id in ascending order. Omit for legacy newest-first behavior.",
            "in": "query",
            "name": "after_id",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RequestRecord"
                  },
                  "type": "array"
                }
              }
            },
            "description": "",
            "headers": {
              "next_after_id": {
                "description": "Present only with after_id: last returned ID, or the supplied cursor for an empty page.",
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              },
              "oldest_retained_id": {
                "description": "Present only with after_id on a nonempty page: the lowest request ID meter still stores, read in the same snapshot. Lower IDs were removed by 365-day retention, which never removes a higher ID.",
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          }
        },
        "tags": []
      }
    },
    "/meter/stats": {
      "get": {
        "operationId": "stats_doc",
        "parameters": [
          {
            "description": "24h (default), 7d, 30d, 365d. Percentiles are exact through 30d and approximate (flagged) beyond.",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelStats"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": ""
          }
        },
        "tags": []
      }
    }
  }
}
