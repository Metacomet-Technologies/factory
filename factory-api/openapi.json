        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/UpsEvent"
            },
            "type": "array"
          },
          "next_before_id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "next_before_ms": {
            "description": "Pass both cursor fields to avoid skipping simultaneous transitions.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "UpsMetric": {
        "properties": {
          "avg": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "max": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpsPoint": {
        "properties": {
          "charge_percent": {
            "$ref": "#/components/schemas/UpsMetric"
          },
          "input_v": {
            "$ref": "#/components/schemas/UpsMetric"
          },
          "load_w": {
            "$ref": "#/components/schemas/UpsMetric"
          },
          "runtime_s": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "sample_count": {
            "format": "int64",
            "type": "integer"
          },
          "ts_ms": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "ts_ms",
          "sample_count",
          "charge_percent",
          "load_w",
          "input_v"
        ],
        "type": "object"
      },
      "UpsSettings": {
        "additionalProperties": false,
        "properties": {
          "battery_installed_ms": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "electricity_rate_micro_usd_per_kwh": {
            "format": "int64",
            "maximum": 10000000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "electricity_rate_micro_usd_per_kwh",
          "battery_installed_ms"
        ],
        "type": "object"
      },
      "Usage": {
        "properties": {
          "generated_at_ms": {
            "format": "int64",
            "type": "integer"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelUsage"
            },
            "type": "array"
          },
          "range": {
            "type": "string"
          },
          "spend_avoided": {
            "items": {
              "$ref": "#/components/schemas/SpendAvoided"
            },
            "type": "array"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "range",
          "generated_at_ms",
          "totals",
          "spend_avoided",
          "models",
          "warnings"
        ],
        "type": "object"
      }
    }
  },
